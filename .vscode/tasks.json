{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "C:/Python313/python.exe",
            "args": [
                "-m",
                "uvicorn",
                "backend.main:app",
                "--reload"
            ],
            "problemMatcher": []
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd frontend && C:/Python313/python.exe -m http.server 5500"
            ],
            "problemMatcher": []
        }
    ]
}